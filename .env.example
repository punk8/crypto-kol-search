# Legacy direct backend selector: mock | official | twitterapi_io | getxapi | third_party | twscrape | fxembed
TWITTER_BACKEND=twitterapi_io
# Discover API provider order. Each entry implements the same X adapter contract.
KOL_X_PROVIDER_CHAIN=fxembed,getxapi
GET_X_API_KEY=
GET_X_API_BASE_URL=https://api.getxapi.com
# Backend-side spend guard. The account balance endpoint is cached and does
# not consume a paid data call.
GET_X_API_DAILY_CALL_LIMIT=120
GET_X_API_MIN_CREDITS=0.05
GET_X_API_BALANCE_CACHE_SECONDS=300
# Used to project the remaining balance safely between free /account/me checks.
GET_X_API_ESTIMATED_CREDITS_PER_CALL=0.001
# Disabled in normal runtime. Tests may opt in explicitly for deterministic fixtures.
KOL_ENABLE_MOCK_BACKEND=false
KOL_ENABLED_PLATFORMS=x
# Required when the backend listens outside loopback. The Vercel frontend sends
# it as Authorization: Bearer <token>. Store it in deployment secrets only.
KOL_BACKEND_API_TOKEN=
KOL_BACKEND_HOST=127.0.0.1
KOL_BACKEND_PORT=8780
# Set only on the Vercel frontend/BFF for split deployment.
KOL_BACKEND_URL=
KOL_BACKEND_REQUEST_TIMEOUT_SECONDS=30
KOL_X_HOT_CONTENT_QUERY=(AI OR crypto OR technology OR startups) min_faves:100 -filter:replies lang:en
KOL_X_HOT_CONTENT_LIMIT=12
# Optional bootstrap until accounts are enrolled into the X KOL repository.
KOL_X_WATCH_HANDLES=
KOL_X_WATCH_POSTS_PER_ACCOUNT=3
KOL_X_KOL_DISCOVERY_DOMAIN=AI agents
KOL_X_KOL_DISCOVERY_LIMIT=8
KOL_X_KOL_CANDIDATE_SAMPLE_SIZE=20
KOL_X_KOL_RECENT_POSTS_PER_ACCOUNT=2
KOL_X_KOL_MIN_ENGAGEMENT=25
KOL_X_KOL_DISCOVERY_CACHE_SECONDS=3600
# Shared PostgreSQL/SQLite snapshots. A live failure may use an expired
# snapshot only within KOL_X_SNAPSHOT_STALE_SECONDS.
KOL_X_TREND_CACHE_SECONDS=1800
KOL_X_CONTENT_CACHE_SECONDS=1800
KOL_X_TIMELINE_CACHE_SECONDS=1800
KOL_X_CONTENT_LOOKUP_CACHE_SECONDS=3600
KOL_X_SNAPSHOT_STALE_SECONDS=86400

# Multi-domain autonomous KOL discovery and Hot Content ranking.
KOL_DISCOVERY_DOMAINS_JSON=[{"key":"ai","name":"AI","query":"AI agents OR LLM OR machine learning"},{"key":"crypto","name":"Crypto","query":"crypto OR bitcoin OR ethereum OR DeFi"},{"key":"financial","name":"Financial","query":"financial markets OR investing OR macroeconomics"}]
KOL_AUTO_WATCHLIST_ENABLED=true
KOL_AUTO_WATCHLIST_MIN_SCORE=75
KOL_AUTO_WATCHLIST_MIN_EVIDENCE=3
KOL_AUTO_WATCHLIST_QUALIFYING_RUNS=2
KOL_AUTO_WATCHLIST_MAX_PER_DOMAIN=20
KOL_HOT_CONTENT_INTERVAL_MINUTES=30
KOL_HOT_CONTENT_WINDOW_HOURS=48
KOL_HOT_CONTENT_MIN_ENGAGEMENT=100
KOL_HOT_FOLLOWING_MIN_ENGAGEMENT=20

# --- Official X API (Bearer / app-only) ---
# See README.md for setup and backend behavior.
X_BEARER_TOKEN=
# Mac production alternative: keep the X token in Keychain.
X_BEARER_TOKEN_KEYCHAIN_SERVICE=

# Optional OAuth 1.0a (unused by V1 read path unless needed)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- TwitterAPI.io ---
TWITTERAPI_IO_API_KEY=
TWITTERAPI_IO_BASE_URL=https://api.twitterapi.io

# --- Third-party Twitter data API ---
# Example: https://api.twitterapi.io  (adjust to your vendor)
TWITTER_TP_BASE_URL=
TWITTER_TP_API_KEY=
# Header name for the API key (default: x-api-key)
TWITTER_TP_API_KEY_HEADER=x-api-key
# Only enable when the vendor actually implements GET /search/users.
TWITTER_TP_SUPPORTS_USER_SEARCH=false

# --- twscrape (optional extra: pip install -e ".[twscrape]") ---
# Use a dedicated test account. Copy auth_token and ct0 from that account's X
# cookies; never commit them or send them to the frontend.
ENABLE_TWSCRAPE=false
TWSCRAPE_USERNAME=kol-search-test
TWSCRAPE_AUTH_TOKEN=
TWSCRAPE_CT0=
TWSCRAPE_ACCOUNTS_DB=data/twscrape_accounts.db
TWSCRAPE_WAIT_TIMEOUT_SECONDS=15
# Deprecated password-login compatibility path. Prefer Cookie credentials above.
TWSCRAPE_ACCOUNTS_FILE=

# --- FxEmbed/FxTwitter (credential-free, best-effort fallback) ---
ENABLE_FXEMBED=true
FXEMBED_BASE_URL=https://api.fxtwitter.com
FXEMBED_TIMEOUT_SECONDS=20

# --- Optional OpenAI classification, clustering, and draft assistance ---
# Safety, conversation verification, quotas, cooldowns, idempotency, and execution
# eligibility remain deterministic. Missing/failed AI falls back to offline behavior.
# Install with: pip install -e ".[ai]"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
DEEP_SEEK_API_KEY=
DEEP_SEEK_BASE_URL=https://api.deepseek.com
DEEP_SEEK_MODEL=deepseek-chat
DEEP_SEEK_TIMEOUT_SECONDS=30
KOL_REPLY_DRAFT_DAILY_LIMIT=50
KOL_REPLY_DRAFT_CACHE_SECONDS=600

# --- Storage / paths ---
KOL_DB_PATH=data/kol_search.db
# Optional shared PostgreSQL database for hosted deployments.
# Keep the password-bearing URL in secret storage; never commit it.
KOL_DATABASE_URL=
# Optional single-backend cache/budget database. Canonical product data still
# uses KOL_DATABASE_URL. Leave empty for shared PostgreSQL provider state.
KOL_PROVIDER_STATE_DB_PATH=
# Mac production alternative: store the URL in Keychain under this service name.
KOL_DATABASE_URL_KEYCHAIN_SERVICE=
# Optional hard read-only mode for a dashboard deployment.
KOL_WEB_READ_ONLY=false

# --- Local dashboard / job budgets ---
KOL_WEB_HOST=127.0.0.1
KOL_WEB_PORT=8765
KOL_ADMIN_USERNAME=admin
# Set both values before allowing VPN access. Local-only development may leave them empty.
KOL_ADMIN_PASSWORD=
KOL_SESSION_SECRET=
KOL_LIVE_WRITE_ENABLED=false
KOL_APPROVED_PRODUCT_DOMAINS=
KOL_COMMENT_DAILY_LIMIT=10
KOL_COMMENT_HOURLY_LIMIT=3
KOL_DM_DAILY_LIMIT=5
KOL_DM_HOURLY_LIMIT=2
KOL_AUTHOR_COOLDOWN_DAYS=7
KOL_GLOBAL_KILL_SWITCH=false
POSTIZ_API_URL=https://api.postiz.com/public/v1
POSTIZ_API_KEY=
# Multiple Postiz integration IDs can be registered from Brand & Safety > Platform Connections.
# The current X module supports text publishing only and does not declare media_upload.
KOL_TIMEZONE=Asia/Shanghai
KOL_ENABLE_SIGNAL_SCAN=true
KOL_SIGNAL_INTERVAL_MINUTES=30
# Optional per-platform overrides; leave blank to use the global interval above.
KOL_X_SIGNAL_INTERVAL_MINUTES=
KOL_XIAOHONGSHU_SIGNAL_INTERVAL_MINUTES=
KOL_X_TRENDS_PER_SCAN=5
KOL_X_TWEETS_PER_TREND=10
# Yahoo WOEID used by the official X trends endpoint. 1 means Worldwide.
KOL_X_TREND_WOEID=1
KOL_SIGNAL_POSTS_PER_ACCOUNT=20
KOL_SIGNAL_REPLY_LIMIT=20
# Stable rotating account batch; content cursors are persisted independently per account.
KOL_PLATFORM_ACCOUNT_BATCH_SIZE=50
KOL_SIGNAL_OPPORTUNITY_TTL_HOURS=24
KOL_DISCOVERY_INTERVAL_HOURS=24
KOL_INACTIVE_PAUSE_DAYS=90
KOL_REVIEW_QUEUE_ENABLED=false
KOL_ACTION_DISPATCH_SECONDS=60
# Automatic writes remain off until sandbox validation is complete.
KOL_AUTO_EXECUTION_ENABLED=false
KOL_AUTO_COMMENT_SCORE=80
KOL_AUTO_DM_FOLLOWUP_SCORE=80
KOL_AUTO_PUBLISH_SCORE=80
KOL_PUBLISH_DAILY_LIMIT=2
KOL_PUBLISH_WINDOWS=09:00-11:00,17:00-20:00
