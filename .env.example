# Backend: mock | official | twitterapi_io | third_party | twscrape | opencli
TWITTER_BACKEND=mock

# OpenCLI 1.8.6 Browser Bridge can be selected directly or used as a sticky fallback.
OPENCLI_COMMAND=opencli
# Browser Bridge profile used explicitly for reads and replies.
OPENCLI_PROFILE=ddd
OPENCLI_TIMEOUT_SECONDS=90
TWITTER_FALLBACK_BACKEND=opencli

# --- Official X API (Bearer / app-only) ---
# See README.md for setup and backend behavior.
X_BEARER_TOKEN=

# Optional OAuth 1.0a (unused by V1 read path unless needed)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- TwitterAPI.io ---
TWITTERAPI_IO_API_KEY=
TWITTERAPI_IO_BASE_URL=https://api.twitterapi.io

# --- Third-party Twitter data API ---
# Example: https://api.twitterapi.io  (adjust to your vendor)
TWITTER_TP_BASE_URL=
TWITTER_TP_API_KEY=
# Header name for the API key (default: x-api-key)
TWITTER_TP_API_KEY_HEADER=x-api-key
# Only enable when the vendor actually implements GET /search/users.
TWITTER_TP_SUPPORTS_USER_SEARCH=false

# --- twscrape (optional extra: pip install -e ".[twscrape]") ---
# Path to accounts file: username:password:email:email_password per line
TWSCRAPE_ACCOUNTS_FILE=
ENABLE_TWSCRAPE=false

# --- Optional OpenAI structured classification ---
# Install with: pip install -e ".[ai]"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# --- Storage / paths ---
KOL_DB_PATH=data/kol_search.db
KOL_OUTPUT_DIR=output

# --- Local dashboard / job budgets ---
KOL_WEB_HOST=127.0.0.1
KOL_WEB_PORT=8765
KOL_TIMEZONE=Asia/Shanghai
KOL_WEEKLY_DAY=sun
KOL_WEEKLY_HOUR=3
KOL_ENABLE_WEEKLY_REFRESH=true
KOL_ENABLE_SIGNAL_SCAN=false
KOL_SIGNAL_INTERVAL_MINUTES=30
KOL_SIGNAL_CORE_ACCOUNTS=20
KOL_SIGNAL_ROTATION_ACCOUNTS=20
KOL_SIGNAL_POSTS_PER_ACCOUNT=20
KOL_SIGNAL_REPLY_LIMIT=20
KOL_SIGNAL_TOPIC_LIMIT=10
KOL_SIGNAL_OPPORTUNITY_TTL_HOURS=24
KOL_MAX_USER_QUERIES=8
KOL_MAX_POST_QUERIES=8
KOL_MAX_CANDIDATES=500
KOL_MAX_ENRICHED_CANDIDATES=200
KOL_MAX_CONTACT_ACCOUNTS=100
KOL_MAX_SITE_PAGES=5
KOL_USE_CONFIGURED_SEEDS=true
